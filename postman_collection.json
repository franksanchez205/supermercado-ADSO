        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login response received', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 202]);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.jwt) {",
                  "  pm.collectionVariables.set('jwt', data.jwt);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
